{
  "name": "neobuy-backend",
  "version": "1.0.0",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/app.js",
    "dev": "node ./node_modules/tsx/dist/cli.mjs watch src/app.ts",
    "migrate": "node -r dotenv/config ./node_modules/db-migrate/bin/db-migrate up",
    "migrate:down": "node -r dotenv/config ./node_modules/db-migrate/bin/db-migrate down",
    "migrate:create": "node -r dotenv/config ./node_modules/db-migrate/bin/db-migrate create",
    "migrate:prod": "node -r dotenv/config ./node_modules/db-migrate/bin/db-migrate up -e prod",
    "test": "jest",
    "test:cart": "jest tests/cart.test.ts",
    "test:concurrency": "jest tests/concurrency.test.ts",
    "test:cron": "jest tests/cron.test.ts",
    "test:dashboard": "jest tests/graphql-dashboard.test.ts",
    "test:stripe": "jest tests/stripe.test.ts",
    "test:wishlist": "jest tests/wishlist.test.ts",
    "test:order": "jest tests/order.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "NeoBuy e-commerce API",
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "db-migrate": "^0.11.14",
    "db-migrate-mysql": "^3.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "graphql": "^16.14.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.22.4",
    "node-cron": "^4.2.1",
    "stripe": "^22.2.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.3.0",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^6.0.3",
    "jest": "^30.2.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
